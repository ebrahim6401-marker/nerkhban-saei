<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg" android:gravity="end">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/refresh" android:layout_width="46dp" android:layout_height="46dp" android:text="↻" android:textColor="#111111" android:textSize="28sp" android:textStyle="bold" android:gravity="center" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="نرخ‌بان ساعی" android:textColor="#111111" android:textStyle="bold" android:textSize="20sp" android:gravity="end" />
        <ImageView android:layout_width="54dp" android:layout_height="54dp" android:src="@drawable/saei_logo" android:contentDescription="لوگوی گروه ساعی" android:scaleType="centerCrop" />
    </LinearLayout>
    <TextView android:id="@+id/eur" style="@style/RateRow" /><TextView android:id="@+id/usd" style="@style/RateRow" />
    <TextView android:id="@+id/aed" style="@style/RateRow" /><TextView android:id="@+id/emami" style="@style/RateRow" />
    <TextView android:id="@+id/half" style="@style/RateRow" /><TextView android:id="@+id/quarter" style="@style/RateRow" />
    <TextView android:id="@+id/updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="در حال دریافت…" android:textColor="#443900" android:textSize="12sp" android:gravity="end" android:paddingTop="7dp" />
</LinearLayout>
