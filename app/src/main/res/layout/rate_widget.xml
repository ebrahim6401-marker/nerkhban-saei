<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg" android:gravity="end">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/refresh" android:layout_width="40dp" android:layout_height="40dp" android:text="↻" android:textColor="#48D7B0" android:textSize="24sp" android:gravity="center" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="نرخ‌بان ساعی" android:textColor="#F4F7F4" android:textStyle="bold" android:textSize="18sp" android:gravity="end" />
    </LinearLayout>
    <TextView android:id="@+id/eur" style="@style/RateRow" /><TextView android:id="@+id/usd" style="@style/RateRow" />
    <TextView android:id="@+id/aed" style="@style/RateRow" /><TextView android:id="@+id/emami" style="@style/RateRow" />
    <TextView android:id="@+id/half" style="@style/RateRow" /><TextView android:id="@+id/quarter" style="@style/RateRow" />
    <TextView android:id="@+id/updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="در حال دریافت…" android:textColor="#8DA2A1" android:textSize="10sp" android:gravity="end" android:paddingTop="6dp" />
</LinearLayout>
